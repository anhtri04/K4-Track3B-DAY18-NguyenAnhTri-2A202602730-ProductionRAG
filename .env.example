# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible endpoint (vLLM / LiteLLM / OpenRouter / Ollama ...).
# Leave BLANK to fall back to official OpenAI.
# OPENAI_BASE_URL=http://localhost:8000/v1
# Optional: chat model name for generation + enrichment + RAGAS judge.
# OPENAI_MODEL=gpt-4o-mini
